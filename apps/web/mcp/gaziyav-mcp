#!/bin/sh
# Gaziyav's MCP server for Claude (stdio). Inside the app it runs on Gaziyav's own Node (Electron as Node), so
# nothing else needs to be installed. Claude Desktop / Claude Code start this file.
DIR="$(cd "$(dirname "$0")" && pwd)"
APP="$(cd "$DIR/../../.." 2>/dev/null && pwd)"
if [ -x "$APP/Contents/MacOS/Gaziyav" ]; then
	ELECTRON_RUN_AS_NODE=1 exec "$APP/Contents/MacOS/Gaziyav" "$DIR/server.mjs" "$@"
fi
exec node "$DIR/server.mjs" "$@"
